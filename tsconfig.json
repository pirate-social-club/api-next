{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@pirate/contracts": ["./packages/contracts/src/index.ts"],
      "@pirate/domain": ["./packages/domain/src/index.ts"],
      "@pirate/application": ["./packages/application/src/index.ts"],
      "@pirate/platform-cf": ["./packages/platform-cf/src/index.ts"],
      "@pirate/testing": ["./packages/testing/src/index.ts"]
    }
  },
  "include": ["packages", "apps"],
    "exclude": ["packages/platform-cf", "apps/jobs-worker"]
}
