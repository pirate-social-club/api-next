{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false
      }
    ],
    "types": ["bun"],
    "paths": {
      "@pirate/contracts": ["./packages/contracts/src/index.ts"],
      "@pirate/api-client": ["./packages/api-client/src/index.ts"],
      "@pirate/domain": ["./packages/domain/src/index.ts"],
      "@pirate/domain/verification": ["./packages/domain/src/verification/index.ts"],
      "@pirate/application": ["./packages/application/src/index.ts"],
      "@pirate/application/*": ["./packages/application/src/*"],
      "@pirate/platform-cf": ["./packages/platform-cf/src/index.ts"],
      "@pirate/platform-cf/config": ["./packages/platform-cf/config/index.ts"],
      "@pirate/platform-cf/postgres": ["./packages/platform-cf/src/postgres.ts"],
      "@pirate/platform-cf/verification-provider-registry": [
        "./packages/platform-cf/src/verification/provider-registry.ts"
      ],
      "@pirate/platform-cf/verification-start-repository": [
        "./packages/platform-cf/src/verification-start-repository.ts"
      ],
      "@pirate/platform-cf/*": ["./packages/platform-cf/src/*"],
      "@pirate/testing": ["./packages/testing/src/index.ts"],
      "@pirate/testing/verification": ["./packages/testing/src/verification/index.ts"]
      ,"@pirate/verifier-response-contract": ["./packages/verifier-response-contract/src/index.ts"]
    }
  },
  "include": ["packages", "apps"],
    "exclude": ["packages/platform-cf", "apps/jobs-worker"]
}
