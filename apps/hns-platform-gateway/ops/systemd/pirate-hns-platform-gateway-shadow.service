[Unit]
Description=Pirate target HNS static platform gateway shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/pirate-hns-platform-gateway-shadow/current
ExecStart=/usr/bin/env bun /srv/pirate-hns-platform-gateway-shadow/current/bin/pirate-hns-platform-gateway.mjs --mode shadow
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
