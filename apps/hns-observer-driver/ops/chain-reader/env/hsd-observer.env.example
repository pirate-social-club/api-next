# Stable host paths: these must not resolve inside an immutable release
# directory, or checkout replacement will orphan the chain state and secret.
HSD_DATA_DIR=/srv/pirate-hns-observer/shared/data
HSD_API_KEY_FILE=/srv/pirate-hns-observer/config/hsd_api_key
# UID/GID that own HSD_DATA_DIR on the deployment host.
HSD_UID=1000
HSD_GID=1000
