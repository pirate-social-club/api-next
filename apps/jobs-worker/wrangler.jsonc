{
  "name": "pirate-jobs-worker",
  "account_id": "ff375d61cdc0c5dc946837f3e37725e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      // Local-only dry-run target; production must reference an existing
      // reviewed Hyperdrive configuration before an authorized deploy.
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "vars": {
    "API_NEXT_ENV": "development",
    "COMMUNITY_PURCHASE_FUNDING_CHAIN_ID": "8453"
  },
  "secrets": {
    "required": ["COMMUNITY_PURCHASE_FUNDING_RPC_URL"]
  },
  "env": {
    "staging": {
      "name": "pirate-jobs-worker-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "CRON_LOCK",
            "class_name": "ScheduledCronLockDO"
          }
        ]
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // Staging-only Hyperdrive; never reuse the production resource.
          "id": "11c1ad1806004f3b87fa771833093132",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "staging",
        "COMMUNITY_PURCHASE_FUNDING_CHAIN_ID": "8453"
        // Staging uses the local alert sink. If external delivery is enabled,
        // inject endpoint URLs and tokens from the staging secret environment.
      },
      "secrets": {
        "required": ["COMMUNITY_PURCHASE_FUNDING_RPC_URL"]
      }
    },
    "production": {
      "name": "pirate-jobs-worker-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "CRON_LOCK",
            "class_name": "ScheduledCronLockDO"
          }
        ]
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // Resource provisioning is intentionally out of scope for M1.
          // The coordinator replaces this with an existing reviewed ID.
          "id": "00000000-0000-0000-0000-000000000000",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "production",
        "COMMUNITY_PURCHASE_FUNDING_CHAIN_ID": "8453"
      },
      "secrets": {
        "required": ["COMMUNITY_PURCHASE_FUNDING_RPC_URL"]
      }
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRON_LOCK",
        "class_name": "ScheduledCronLockDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScheduledCronLockDO"]
    }
  ]
}
