CONTROL_PLANE_POSTGRES_URL=postgres://root_import_executor:replace@control-plane.example:5432/pirate?sslmode=verify-full
HNS_AUTHORITY_EXECUTOR_ID=production-authority-1
HNS_AUTHORITY_ENVIRONMENT=production
HNS_AUTHORITY_GATEWAY_IPV4=192.0.2.1
HNS_AUTHORITY_SHARED_TLSA=3 1 1 replace_with_64_lowercase_hex_characters
HNS_AUTHORITY_GATEWAY_DEPLOYMENT_REFERENCE=replace_with_accepted_gateway_deployment_reference
HNS_AUTHORITY_TTL_SECONDS=300
HNS_AUTHORITY_READINESS_VALID_FOR_SECONDS=604800
HNS_AUTHORITY_READINESS_TIMEOUT_MS=5000
HNS_AUTHORITY_CHAIN_NETWORK=main
HNS_AUTHORITY_CHAIN_GENESIS_BLOCK_HASH=replace_with_64_lowercase_hex_characters
HNS_AUTHORITY_NS1_NAME=ns1.pirate
HNS_AUTHORITY_NS1_ADDRESS=192.0.2.53
HNS_AUTHORITY_NS2_NAME=ns2.pirate
HNS_AUTHORITY_NS2_ADDRESS=192.0.2.54
HNS_AUTHORITY_DNS_LOCAL_IPV4=0.0.0.0
HNS_AUTHORITY_GATEWAY_LOCAL_IPV4=0.0.0.0
HNS_AUTHORITY_HSD_RPC_URL=http://127.0.0.1:14037
HNS_AUTHORITY_HSD_AUTHORIZATION=Basic replace
HNS_AUTHORITY_PDNS_API_URL=http://127.0.0.1:8081
HNS_AUTHORITY_PDNS_API_KEY=replace
HNS_AUTHORITY_PDNS_SERVER_ID=localhost
HNS_AUTHORITY_PDNS_SOA_CONTENT=ns1.pirate. hostmaster.pirate. 1 10800 3600 604800 3600
HNS_AUTHORITY_AXFR_TSIG_KEY_NAME=pirate-axfr
