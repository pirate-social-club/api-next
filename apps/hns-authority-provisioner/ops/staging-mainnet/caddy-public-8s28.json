{
  "admin": { "disabled": true },
  "apps": {
    "tls": {
      "certificates": {
        "load_files": [
          {
            "certificate": "/etc/pirate-hns-staging/public-gateway/8s28.crt",
            "key": "/etc/pirate-hns-staging/public-gateway/8s28.key",
            "tags": ["staging-8s28"]
          }
        ]
      }
    },
    "http": {
      "servers": {
        "staging-8s28": {
          "listen": ["81.15.150.167:443"],
          "protocols": ["h1", "h2"],
          "automatic_https": { "disable": true },
          "tls_connection_policies": [
            { "certificate_selection": { "any_tag": ["staging-8s28"] } }
          ],
          "routes": [
            {
              "handle": [
                { "handler": "headers", "request": { "delete": ["X-Pirate-Gateway-*"] } },
                { "handler": "headers", "request": { "delete": ["X-Pirate-Hns-Forwarder-*"] } },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "127.0.0.1:4269" }],
                  "headers": {
                    "request": {
                      "set": {
                        "X-Pirate-Gateway-External-Scheme": ["https"],
                        "X-Pirate-Gateway-Tls-Sni": ["{http.request.tls.server_name}"]
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
