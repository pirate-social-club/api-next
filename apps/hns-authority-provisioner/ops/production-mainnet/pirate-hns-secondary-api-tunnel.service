[Unit]
Description=Private production HNS secondary PowerDNS API forward
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/ssh -F /dev/null -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o IdentitiesOnly=yes -o IdentityAgent=none -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%d/secondary-known-hosts -o ServerAliveInterval=30 -o ServerAliveCountMax=2 -i %d/secondary-tunnel-key -L 127.0.0.1:18081:127.0.0.1:8081 ubuntu@81.15.150.159
LoadCredential=secondary-tunnel-key:/etc/pirate/hns-secondary-api-tunnel/id_ed25519
LoadCredential=secondary-known-hosts:/etc/pirate/hns-secondary-api-tunnel/known_hosts
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=81.15.150.159
IPAddressAllow=127.0.0.1
CapabilityBoundingSet=
UMask=0077
MemoryMax=64M
CPUQuota=10%
TasksMax=32
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
