# The staging profile captures its signer, TLS identity and complete private
# runtime configuration. It refuses a declared Spaces input and requires the
# TLS directory beneath the runtime directory, archived once.
HNS_BACKUP_PROFILE=staging-hns
BACKUP_STAGING_ROOT=/run/pirate-hns-staging-backup
PDNS_SQLITE_DB=/var/lib/pirate-hns-staging/docker/volumes/pirate-hns-public-ns2-data/_data/pdns.sqlite3
HNS_RUNTIME_STATE_DIR=/etc/pirate-hns-staging
HNS_DANE_CERT_DIR=/etc/pirate-hns-staging/public-gateway
HNS_CADDY_CONFIG_FILE=/etc/pirate-hns-staging/caddy-209.json
BACKUP_QUIESCE_UNITS=

# Existing scoped uploader and public age recipient, delivered privately.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=
RCLONE_CONFIG=/etc/pirate-hns-staging-backup/rclone.conf
BACKUP_RETENTION_VERIFY=true
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_MIN_RETENTION_DAYS=30
HNS_HEALTHCHECK_URL_FILE=/etc/pirate-healthchecks/hns-staging-state-backup.url
DEPLOY_ROOT=/srv/pirate-hns-staging-backup
