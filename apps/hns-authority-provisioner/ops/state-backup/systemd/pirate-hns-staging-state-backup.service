[Unit]
Description=Encrypted recovery of staging HNS authority and TLS state
After=network-online.target pirate-hns-staging-docker.service
Wants=network-online.target
OnFailure=pirate-hns-staging-state-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/srv/pirate-hns-staging-backup/config/backup.env
TemporaryFileSystem=/run/pirate-hns-staging-backup:rw,nosuid,nodev,noexec,size=256M,mode=0700
ExecStart=/usr/bin/flock --nonblock /run/pirate-hns-staging-relocation.lock /srv/pirate-hns-staging-backup/current/hns-state-backup.sh
ExecStartPost=/srv/pirate-hns-staging-backup/current/bin/heartbeat.sh
MemoryMax=384M
MemorySwapMax=0
CPUQuota=15%
TasksMax=32
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
