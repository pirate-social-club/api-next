[Unit]
Description=Pirate isolated HNS staging authority provisioner
After=network-online.target pirate-hns-staging-docker.service pirate-hns-staging-gateway.service
Wants=network-online.target
Requires=pirate-hns-staging-docker.service

[Service]
Type=simple
DynamicUser=yes
Slice=pirate-hns-staging.slice
WorkingDirectory=/srv/pirate-hns-staging/provisioner/current
EnvironmentFile=/etc/pirate-hns-staging/provisioner.env
LoadCredential=hns_axfr_tsig_secret:/etc/pirate-hns-staging/axfr-tsig-secret
Environment=HNS_AUTHORITY_AXFR_TSIG_SECRET_FILE=/run/credentials/pirate-hns-staging-provisioner.service/hns_axfr_tsig_secret
Environment=HNS_AUTHORITY_DEPLOYMENT_MANIFEST=/srv/pirate-hns-staging/provisioner/current/deployment-manifest.json
ExecStartPre=/usr/bin/env bun /srv/pirate-hns-staging/provisioner/current/bin/pirate-hns-authority-provisioner.mjs --verify-schema --manifest /srv/pirate-hns-staging/provisioner/current/deployment-manifest.json --bundle /srv/pirate-hns-staging/provisioner/current/bin/pirate-hns-authority-provisioner.mjs
ExecStart=/usr/bin/env bun /srv/pirate-hns-staging/provisioner/current/bin/pirate-hns-authority-provisioner.mjs --serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=65
MemoryMax=192M
CPUQuota=20%
TasksMax=32
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
