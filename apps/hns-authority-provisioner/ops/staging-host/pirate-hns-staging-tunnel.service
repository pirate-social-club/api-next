[Unit]
Description=Isolated HNS staging private connector
Wants=network-online.target
After=network-online.target pirate-hns-staging-observer.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
Slice=pirate-hns-staging.slice
LoadCredential=tunnel-token:/etc/pirate-hns-staging/tunnel-token
ExecStart=/srv/pirate-hns-staging/tunnel/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:4083 --loglevel warn run --token-file /run/credentials/pirate-hns-staging-tunnel.service/tunnel-token
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=96M
CPUQuota=15%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
