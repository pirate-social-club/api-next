# Query both public authoritative serving paths, never the database/API.
HNS_RRSIG_SERVERS=94.103.168.161,81.15.150.159
# rrsig-probe.pirate exercises wildcard synthesis and its signature.
HNS_RRSIG_CHECKS=pirate.:SOA,pirate.:A,app.pirate.:A,api.pirate.:A,profile.pirate.:A,rrsig-probe.pirate.:A,_pirate.pirate.:TXT,_443._tcp.pirate.:TLSA,_443._tcp.app.pirate.:TLSA,_443._tcp.api.pirate.:TLSA,_443._tcp.profile.pirate.:TLSA,*.pirate.:TLSA
HNS_RRSIG_MIN_REMAINING_SECONDS=518400
# Dedicated hourly check. Do not reuse the deployment-drift check's URL.
HNS_HEALTHCHECK_URL_FILE=/etc/pirate-healthchecks/hns-rrsig.url
