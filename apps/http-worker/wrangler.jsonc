{
  "name": "pirate-http-worker",
  "account_id": "08a4c22cf52e2ecae883e36f80a33f4a",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      // REFERENCE ONLY. Provisioning and replacement are user-authorized and
      // intentionally out of scope for this lane.
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRATION_IP_LIMITER",
        "class_name": "RegistrationIpRateLimiterDO"
      },
      {
        "name": "REGISTRATION_APPLICATION_LIMITER",
        "class_name": "RegistrationApplicationRateLimiterDO"
      },
      {
        "name": "HNS_COMMUNITY_APP_API_REPLAY",
        "class_name": "HnsForwarderReplayStoreDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistrationIpRateLimiterDO",
        "RegistrationApplicationRateLimiterDO"
      ]
    },
    {
      // The staging-only Self callback capture seam held this class from its
      // lane deployment; v3 retires it after the capture lane was parked.
      "tag": "v2",
      "new_sqlite_classes": ["SelfCallbackCaptureDO"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["SelfCallbackCaptureDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["HnsForwarderReplayStoreDO"]
    }
  ],
  "vars": {
    "API_NEXT_ENV": "development",
    "MEGAPOT_REWARDS_ENABLED": "false",
    "MEGAPOT_CHAIN_ID": "84532",
    "MEGAPOT_ATTESTATION_ID": "megapot-base-sepolia-v2",
    "MEGAPOT_REQUIRED_CONFIRMATIONS": "3",
    "MEDIA_UPLOADS_ENABLED": "false",
    "MEDIA_INGRESS_R2_ACCOUNT_ID": "",
    "MEDIA_INGRESS_R2_BUCKET_NAME": "",
    "REGISTRATION_IP_LIMIT": "5",
    "REGISTRATION_IP_WINDOW_SECONDS": "900",
    "REGISTRATION_APPLICATION_LIMIT": "100",
    "REGISTRATION_APPLICATION_WINDOW_SECONDS": "60",
    "CORS_ORIGIN": "http://localhost:5173",
    "SELF_PASS_ENABLED": "false",
    "SELF_PASS_APP_NAME": "Pirate",
    "SELF_PASS_MOCK_PASSPORT": "false",
    "VERY_OAUTH_ENABLED": "false",
    "OPENAI_MODERATION_ENABLED": "false",
    "OPENAI_MODERATION_MODEL": "omni-moderation-2024-09-26",
    "OPENAI_MODERATION_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODERATION_TIMEOUT_MS": "10000",
    "HNS_OWNERSHIP_ENABLED": "false",
    "HNS_COMMUNITY_APP_API_ENABLED": "false",
    "HNS_COMMUNITY_APP_API_PROTECTED_ORIGIN": "",
    "HNS_COMMUNITY_APP_API_ACCESS_ISSUER": "",
    "HNS_COMMUNITY_APP_API_ACCESS_JWKS_URL": "",
    "HNS_COMMUNITY_APP_API_ACCESS_AUDIENCE": "",
    "HNS_FORWARDER_V3_KEY_REGISTRY_REFERENCE": "",
    "HNS_FORWARDER_V3_KEY_REGISTRY_VERSION": "",
    "HNS_FORWARDER_V3_FRESHNESS_WINDOW_SECONDS": "0",
    "HNS_FORWARDER_V3_FUTURE_CLOCK_SKEW_SECONDS": "-1",
    // Reviewed inventory: development currently has no additional internal
    // credential headers beyond the platform denylist.
    "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
    "PIRATE_APP_JWT_ISSUER": "api-next-session-development",
    "PIRATE_APP_JWT_AUDIENCE": "api-next-browser-development",
    "PIRATE_APP_JWT_SCOPE": "api-next-browser-session-development",
    "PRIVY_JWT_ISSUER": "privy.io",
    "PRIVY_API_URL": "https://api.privy.io"
  },
  "secrets": {
    "required": [
      "PIRATE_APP_JWT_PRIVATE_KEY",
      "PIRATE_APP_JWT_PUBLIC_KEY",
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET",
      "HNS_FORWARDER_V3_HMAC_KEY_REGISTRY",
      "COMMUNITY_PURCHASE_FUNDING_RPC_URL",
      "MEGAPOT_V2_RPC_URL"
    ]
  },
  "env": {
    "staging": {
      "name": "pirate-http-worker-staging",
      // Keep workers.dev as an operator fallback while the canonical custom
      // domain is the public staging origin.
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api-next-staging.pirate.sc",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRATION_IP_LIMITER",
            "class_name": "RegistrationIpRateLimiterDO"
          },
          {
            "name": "REGISTRATION_APPLICATION_LIMITER",
            "class_name": "RegistrationApplicationRateLimiterDO"
          },
          {
            "name": "HNS_COMMUNITY_APP_API_REPLAY",
            "class_name": "HnsForwarderReplayStoreDO"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // Staging-only Hyperdrive; never reuse the production resource.
          "id": "8cb7658a0f7143359c1becfec6a15c23",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_INGRESS",
          "bucket_name": "pirate-media-ingress-staging"
        },
        {
          "binding": "MEDIA_IMMUTABLE_ORIGINALS",
          "bucket_name": "pirate-media-immutable-staging"
