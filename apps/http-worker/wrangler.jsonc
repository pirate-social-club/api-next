{
  "name": "pirate-http-worker",
  "account_id": "ff375d61cdc0c5dc946837f3e37725e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      // REFERENCE ONLY. Provisioning and replacement are user-authorized and
      // intentionally out of scope for this lane.
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "vars": {
    "API_NEXT_ENV": "development",
    "CORS_ORIGIN": "http://localhost:5173",
    "SELF_PASS_ENABLED": "false",
    "SELF_PASS_APP_NAME": "Pirate",
    "SELF_PASS_MOCK_PASSPORT": "false",
    // Reviewed inventory: development currently has no additional internal
    // credential headers beyond the platform denylist.
    "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
    "PRIVY_API_URL": "https://auth.privy.io"
  },
  "secrets": {
    "required": [
      "PIRATE_APP_JWT_PRIVATE_KEY",
      "PIRATE_APP_JWT_PUBLIC_KEY",
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ]
  },
  "env": {
    "staging": {
      "name": "pirate-http-worker-staging",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api-next-staging.pirate.sc",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // Staging-only Hyperdrive; never reuse the production resource.
          "id": "11c1ad1806004f3b87fa771833093132",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "staging",
        "CORS_ORIGIN": "https://staging.pirate.sc",
        "PIRATE_API_PUBLIC_ORIGIN": "https://api-next-staging.pirate.sc",
        "SELF_PASS_ENABLED": "false",
        "SELF_PASS_APP_NAME": "Pirate",
        "SELF_PASS_MOCK_PASSPORT": "false",
        "PIRATE_APP_JWT_ISSUER": "pirate-api-next-staging",
        "PIRATE_APP_JWT_AUDIENCE": "pirate-app-staging",
        "PIRATE_APP_JWT_TTL_SECONDS": "3600",
        "PRIVY_JWT_ISSUER": "privy.io",
        // PRIVY_JWKS_URL and PRIVY_JWT_AUDIENCE are derived from the
        // staging Privy app and are injected at deployment time.
        "AUTH_UPSTREAM_JWT_JWKS_URL": "https://api-staging.pirate.sc/.well-known/jwks.json",
        "AUTH_UPSTREAM_JWT_ISSUER": "pirate-api-staging",
        "AUTH_UPSTREAM_JWT_AUDIENCE": "pirate-app-staging",
        // Reviewed inventory: staging currently has no additional internal
        // credential headers beyond the platform denylist.
        "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET"
        ]
      }
    },
    "production": {
      "name": "pirate-http-worker-production",
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // REFERENCE ONLY. Replace with the user-provisioned production ID.
          "id": "00000000-0000-0000-0000-000000000000",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "production",
        "CORS_ORIGIN": "https://pirate.app,https://pirate.sc",
        "SELF_PASS_ENABLED": "false",
        "SELF_PASS_APP_NAME": "Pirate",
        "SELF_PASS_MOCK_PASSPORT": "false",
        // Reviewed inventory: production currently has no additional internal
        // credential headers beyond the platform denylist.
        "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET"
        ]
      }
    }
  }
}
