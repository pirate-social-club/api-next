{
  "name": "pirate-http-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      // REFERENCE ONLY. Provisioning and replacement are user-authorized and
      // intentionally out of scope for this lane.
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "vars": {
    "API_NEXT_ENV": "development",
    "CORS_ORIGIN": "http://localhost:5173",
    "PRIVY_API_URL": "https://auth.privy.io"
  },
  "secrets": {
    "required": [
      "PIRATE_APP_JWT_PRIVATE_KEY",
      "PIRATE_APP_JWT_PUBLIC_KEY",
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET"
    ]
  },
  "env": {
    "staging": {
      "name": "pirate-http-worker-staging",
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // REFERENCE ONLY. Replace with the user-provisioned staging ID.
          "id": "8cb7658a0f7143359c1becfec6a15c23",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "staging",
        "CORS_ORIGIN": "https://staging.pirate.sc",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET"
        ]
      }
    },
    "production": {
      "name": "pirate-http-worker-production",
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // REFERENCE ONLY. Replace with the user-provisioned production ID.
          "id": "00000000-0000-0000-0000-000000000000",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "production",
        "CORS_ORIGIN": "https://pirate.app,https://pirate.sc",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET"
        ]
      }
    }
  }
}
