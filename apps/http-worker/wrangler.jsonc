{
  "name": "pirate-http-worker",
  "account_id": "ff375d61cdc0c5dc946837f3e37725e0",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      // REFERENCE ONLY. Provisioning and replacement are user-authorized and
      // intentionally out of scope for this lane.
      "id": "00000000-0000-0000-0000-000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRATION_IP_LIMITER",
        "class_name": "RegistrationIpRateLimiterDO"
      },
      {
        "name": "REGISTRATION_APPLICATION_LIMITER",
        "class_name": "RegistrationApplicationRateLimiterDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistrationIpRateLimiterDO",
        "RegistrationApplicationRateLimiterDO"
      ]
    },
    {
      // The staging-only Self callback capture seam held this class from its
      // lane deployment; v3 retires it after the capture lane was parked.
      "tag": "v2",
      "new_sqlite_classes": ["SelfCallbackCaptureDO"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["SelfCallbackCaptureDO"]
    }
  ],
  "vars": {
    "API_NEXT_ENV": "development",
    "REGISTRATION_IP_LIMIT": "5",
    "REGISTRATION_IP_WINDOW_SECONDS": "900",
    "REGISTRATION_APPLICATION_LIMIT": "100",
    "REGISTRATION_APPLICATION_WINDOW_SECONDS": "60",
    "CORS_ORIGIN": "http://localhost:5173",
    "SELF_PASS_ENABLED": "false",
    "SELF_PASS_APP_NAME": "Pirate",
    "SELF_PASS_MOCK_PASSPORT": "false",
    // Reviewed inventory: development currently has no additional internal
    // credential headers beyond the platform denylist.
    "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
    "PIRATE_APP_JWT_ISSUER": "api-next-session-development",
    "PIRATE_APP_JWT_AUDIENCE": "api-next-browser-development",
    "PIRATE_APP_JWT_SCOPE": "api-next-browser-session-development",
    "PRIVY_API_URL": "https://auth.privy.io"
  },
  "secrets": {
    "required": [
      "PIRATE_APP_JWT_PRIVATE_KEY",
      "PIRATE_APP_JWT_PUBLIC_KEY",
      "PRIVY_APP_ID",
      "PRIVY_APP_SECRET",
      "COMMUNITY_PURCHASE_FUNDING_RPC_URL"
    ]
  },
  "env": {
    "staging": {
      "name": "pirate-http-worker-staging",
      "workers_dev": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRATION_IP_LIMITER",
            "class_name": "RegistrationIpRateLimiterDO"
          },
          {
            "name": "REGISTRATION_APPLICATION_LIMITER",
            "class_name": "RegistrationApplicationRateLimiterDO"
          }
        ]
      },
      "routes": [
        {
          "pattern": "api-next-staging.pirate.sc",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // Staging-only Hyperdrive; never reuse the production resource.
          "id": "11c1ad1806004f3b87fa771833093132",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "staging",
        "REGISTRATION_IP_LIMIT": "5",
        "REGISTRATION_IP_WINDOW_SECONDS": "900",
        "REGISTRATION_APPLICATION_LIMIT": "100",
        "REGISTRATION_APPLICATION_WINDOW_SECONDS": "60",
        "CORS_ORIGIN": "https://staging.pirate.sc,https://web-next-staging.pirate.sc",
        "PIRATE_API_PUBLIC_ORIGIN": "https://api-next-staging.pirate.sc",
        "SELF_PASS_ENABLED": "true",
        "SELF_PASS_APP_NAME": "Pirate",
        // Staging is the developer-document environment. A separately
        // authorized live-document deployment is required for physical proof.
        "SELF_PASS_MOCK_PASSPORT": "true",
        "ZKPASSPORT_ENABLED": "true",
        "ZKPASSPORT_DOMAIN": "web-next-staging.pirate.sc",
        "ZKPASSPORT_NAME": "Pirate",
        "ZKPASSPORT_LOGO": "",
        "ZKPASSPORT_VERIFIER_URL": "https://zkpassport-verifier-staging.pirate.sc",
        "ZKPASSPORT_DEV_MODE": "true",
        "PIRATE_APP_JWT_ISSUER": "api-next-session-staging",
        "PIRATE_APP_JWT_AUDIENCE": "api-next-browser-staging",
        "PIRATE_APP_JWT_SCOPE": "api-next-browser-session-staging",
        "PIRATE_APP_JWT_TTL_SECONDS": "3600",
        "PRIVY_JWT_ISSUER": "privy.io",
        // PRIVY_JWKS_URL and PRIVY_JWT_AUDIENCE are derived from the
        // staging Privy app and are injected at deployment time.
        // Reviewed inventory: staging currently has no additional internal
        // credential headers beyond the platform denylist.
        "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET",
          "ZKPASSPORT_VERIFIER_SHARED_SECRET",
          "ZKPASSPORT_VERIFIER_RESPONSE_SIGNING_SECRET",
          "ZKPASSPORT_VERIFIER_RESPONSE_SIGNING_KEY_ID",
          "COMMUNITY_PURCHASE_FUNDING_RPC_URL"
        ]
      }
    },
    "production": {
      "name": "pirate-http-worker-production",
      "durable_objects": {
        "bindings": [
          {
            "name": "REGISTRATION_IP_LIMITER",
            "class_name": "RegistrationIpRateLimiterDO"
          },
          {
            "name": "REGISTRATION_APPLICATION_LIMITER",
            "class_name": "RegistrationApplicationRateLimiterDO"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "CONTROL_PLANE",
          // REFERENCE ONLY. Replace with the user-provisioned production ID.
          "id": "00000000-0000-0000-0000-000000000000",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        "API_NEXT_ENV": "production",
        "REGISTRATION_IP_LIMIT": "5",
        "REGISTRATION_IP_WINDOW_SECONDS": "900",
        "REGISTRATION_APPLICATION_LIMIT": "100",
        "REGISTRATION_APPLICATION_WINDOW_SECONDS": "60",
        "CORS_ORIGIN": "https://pirate.app,https://pirate.sc",
        "SELF_PASS_ENABLED": "false",
        "SELF_PASS_APP_NAME": "Pirate",
        "SELF_PASS_MOCK_PASSPORT": "false",
        "PIRATE_APP_JWT_ISSUER": "api-next-session-production",
        "PIRATE_APP_JWT_AUDIENCE": "api-next-browser-production",
        "PIRATE_APP_JWT_SCOPE": "api-next-browser-session-production",
        // Reviewed inventory: production currently has no additional internal
        // credential headers beyond the platform denylist.
        "VERIFICATION_CALLBACK_CREDENTIAL_HEADERS": "",
        "PRIVY_API_URL": "https://auth.privy.io"
      },
      "secrets": {
        "required": [
          "PIRATE_APP_JWT_PRIVATE_KEY",
          "PIRATE_APP_JWT_PUBLIC_KEY",
          "PRIVY_APP_ID",
          "PRIVY_APP_SECRET",
          "COMMUNITY_PURCHASE_FUNDING_RPC_URL"
        ]
      }
    }
  }
}
