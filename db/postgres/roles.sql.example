-- Operational example only. Apply through the provider's role-management
-- workflow, never as an application migration and never with a checked-in
-- password.

CREATE ROLE api_next_app LOGIN;
REVOKE ALL ON SCHEMA public FROM api_next_app;
GRANT USAGE ON SCHEMA public TO api_next_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO api_next_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE ON TABLES TO api_next_app;

-- Canonical M3 lifecycle rows are mutable only through guarded transitions;
-- the runtime role never owns retention or deletion.
REVOKE DELETE ON
  community_purchase_funding_journal,
  community_purchase_funding_requests,
  community_purchase_funding_plans
FROM api_next_app;

-- Money evidence and derived receipts are append-only even if a deployment
-- role is accidentally broader than the repository methods.
REVOKE UPDATE, DELETE ON
  community_purchase_funding_transaction_claims,
  community_purchase_funding_transitions,
  community_purchase_funding_receipts,
  community_purchase_funding_reconciliation_operator_actions,
  community_route_lifecycle_transitions,
  community_creation_intent_revisions,
  community_policy_provider_bindings,
  community_creation_quota_approvals,
  community_creation_subject_claims
FROM api_next_app;

-- The current creation-intent projection advances through guarded revisions
-- but is retained permanently with its immutable revision ledger.
REVOKE DELETE ON community_creation_intents FROM api_next_app;

-- Song owner policy changes and video authorization observations are exposed
-- only through their fenced routines. The immutable ledgers are never writable
-- directly by the runtime role.
REVOKE INSERT, UPDATE, DELETE ON
  song_owner_policy_revisions,
  song_derivative_video_policy_observations
FROM api_next_app;
REVOKE INSERT, UPDATE, DELETE ON song_owner_policies FROM api_next_app;
GRANT EXECUTE ON FUNCTION append_song_owner_policy_revision_v1(
  TEXT, TEXT, TEXT, BIGINT, TEXT, TEXT, TEXT
) TO api_next_app;
GRANT EXECUTE ON FUNCTION observe_song_derivative_video_policy_v1(
  TEXT, TEXT, BIGINT, TEXT, TEXT, BIGINT, TEXT
) TO api_next_app;
