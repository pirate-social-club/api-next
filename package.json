{
  "name": "api-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "biome check . && tsc --noEmit -p tsconfig.json && bun run lint:deps",
    "lint:deps": "node scripts/check-deps.mjs",
    "generate:contracts": "bun scripts/generate-contracts.ts",
    "check:fresh": "bun scripts/check-contract-fresh.ts",
    "knip": "knip",
    "test": "bun test",
    "check:breaking": "bun scripts/check-openapi-breaking.ts --base-sha \"${OPENAPI_BASE_SHA:-HEAD^1}\""
  },
  "dependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "knip": "^6.32.2",
    "typescript": "^7.0.2"
  }
}
