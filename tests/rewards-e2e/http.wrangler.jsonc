    "nodejs_compat"
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "hyperdrive": [
    {
      "binding": "CONTROL_PLANE",
      "id": "04a1c805805d42d6bfc67ae7b005ec93"
    }
  ],
  "workflows": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRATION_IP_LIMITER",
        "class_name": "RegistrationIpRateLimiterDO"
      },
      {
        "name": "REGISTRATION_APPLICATION_LIMITER",
        "class_name": "RegistrationApplicationRateLimiterDO"
      },
      {
        "name": "HNS_COMMUNITY_APP_API_REPLAY",
        "class_name": "HnsForwarderReplayStoreDO"
      },
      {
        "name": "SONG_PLAYBACK_RATE_LIMITER",
        "class_name": "VideoPlaybackRateLimiterDO"
      },
      {
        "name": "VIDEO_PLAYBACK_RATE_LIMITER",
        "class_name": "VideoPlaybackRateLimiterDO"
      },
      {
        "name": "KARAOKE_ATTEMPT",
        "class_name": "KaraokeAttemptDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistrationIpRateLimiterDO",
        "RegistrationApplicationRateLimiterDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SelfCallbackCaptureDO"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "SelfCallbackCaptureDO"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "HnsForwarderReplayStoreDO"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "KaraokeAttemptDO"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "VideoPlaybackRateLimiterDO"
      ]
    }
  ],
  "r2_buckets": [
