[Unit]
Description=Hosted failure signal for deployment drift in Pirate VPS role %i

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pirate-deployment-verify/%i.env
ExecStart=/bin/bash -c 'exec "$DEPLOY_ROOT/current/bin/alert-on-failure.sh" "pirate-deployment-verify@$1.service"' -- %i
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
