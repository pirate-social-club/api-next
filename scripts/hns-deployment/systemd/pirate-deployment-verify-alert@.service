[Unit]
Description=Hosted failure signal for failed unit %i

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pirate-deployment-verify.env
ExecStart=/bin/bash -c 'exec "$DEPLOY_ROOT/current/bin/alert-on-failure.sh" "$1"' -- %i
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
