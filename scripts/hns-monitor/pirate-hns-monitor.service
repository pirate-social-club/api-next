[Unit]
Description=Observe HNS serving evidence and deliver operator alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=true
StateDirectory=pirate-hns-monitor
StateDirectoryMode=0700
EnvironmentFile=/etc/pirate-hns-monitor/environment
ExecStart=/usr/bin/env bun /srv/pirate-hns-monitor/current/hns-monitor.mjs --config /etc/pirate-hns-monitor/monitor.json --state /var/lib/pirate-hns-monitor/receipt.sqlite --deliver
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
