[Unit]
Description=Observe HNS serving evidence and deliver operator alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=true
EnvironmentFile=/etc/pirate-hns-monitor/environment
LoadCredential=monitor.json:/etc/pirate-hns-monitor/monitor.json
LoadCredential=healthcheck-url:/etc/pirate-hns-monitor/healthcheck-url
Environment=HNS_HEALTHCHECK_URL_FILE=%d/healthcheck-url
ExecStart=/usr/bin/env bun /srv/pirate-hns-monitor/current/hns-monitor.mjs --config %d/monitor.json --healthcheck-sender /srv/pirate-hns-monitor/current/ping-healthcheck.py --deliver
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
