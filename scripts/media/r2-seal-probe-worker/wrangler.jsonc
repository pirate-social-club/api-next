{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "api-next-r2-seal-proof-local",
  "main": "./index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PROOF_PREFIX": "local-r2-binding-proof",
    "PROOF_TARGET_LABEL": "local-only"
  },
  "r2_buckets": [
    {
      "binding": "PROOF_BUCKET",
      "bucket_name": "api-next-r2-seal-proof-local"
    }
  ]
}
